{
  "description": "Loads the kitchen into sessions of projects that have a kitchen home, and keeps the AI's edits off the code an owner ticket gives to the owner.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/kitchen.py\" guard"
          }
        ]
      }
    ]
  }
}
